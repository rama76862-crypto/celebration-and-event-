# AI Configuration (Optional: App falls back cleanly to curated rules if omitted)
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_BASE_URL=

# App Server Settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Comma-separated public frontend URLs allowed to call this API.
FRONTEND_ORIGINS=http://localhost:3000

# Enable only when a known reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_IPS=
